{
  "name": "@gudform/sdk",
  "version": "1.1.0",
  "description": "Official TypeScript/JavaScript SDK for the GudForm API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "keywords": [
    "gudform",
    "forms",
    "api",
    "sdk",
    "typeform",
    "survey"
  ],
  "license": "MIT",
  "peerDependencies": {},
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
