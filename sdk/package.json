{
  "name": "@gudlab/gudform",
  "version": "1.2.1",
  "description": "Official TypeScript/JavaScript SDK for the GudForm API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "keywords": [
    "gudform",
    "forms",
    "api",
    "sdk",
    "typeform",
    "survey"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gudlab/gudform-core.git",
    "directory": "sdk"
  },
  "homepage": "https://gudform.com",
  "bugs": {
    "url": "https://github.com/gudlab/gudform-core/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {},
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
