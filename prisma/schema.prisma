generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum FormThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum QuestionType {
  WELCOME_SCREEN
  SHORT_TEXT
  LONG_TEXT
  MULTIPLE_CHOICE
  DROPDOWN
  EMAIL
  NUMBER
  PHONE
  DATE
  RATING
  SCALE
  YES_NO
  FILE_UPLOAD
  STATEMENT
  THANK_YOU_SCREEN
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map(name: "created_at")
  updatedAt         DateTime @default(now()) @map(name: "updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map(name: "accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map(name: "sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now()) @map(name: "created_at")
  updatedAt     DateTime  @default(now()) @map(name: "updated_at")
  role          UserRole  @default(USER)

  // Notification preferences
  notifyResponses Boolean @default(true) @map("notify_responses")
  notifyStorage   Boolean @default(true) @map("notify_storage")
  marketingEmails Boolean @default(false) @map("marketing_emails")

  accounts    Account[]
  sessions    Session[]
  forms       Form[]
  teamMembers TeamMember[]
  apiKeys     ApiKey[]
  collections Collection[]
  fileUploads FileUpload[]

  @@map(name: "users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map(name: "verification_tokens")
}

model Form {
  id          String     @id @default(cuid())
  title       String     @default("Untitled Form")
  description String?
  slug        String     @unique @default(cuid())
  status      FormStatus @default(DRAFT)
  userId      String

  themeColor      String        @default("#6366f1")
  backgroundColor String        @default("#ffffff")
  themeMode       FormThemeMode @default(LIGHT)
  showProgressBar Boolean       @default(true)
  redirectUrl     String?
  notifyOnResponse Boolean      @default(true)
  closeDate       DateTime?
  responseLimit   Int?

  webhookUrl           String?
  webhookSecret        String?
  autoResponderEnabled Boolean @default(false)
  autoResponderSubject String?
  autoResponderMessage String?  @db.Text
  removeBranding       Boolean @default(false)

  paymentEnabled       Boolean @default(false) @map("payment_enabled")
  paymentAmount        Int?    @map("payment_amount")
  paymentCurrency      String  @default("usd") @map("payment_currency")
  paymentDescription   String? @map("payment_description")
  paymentOptions       Json?   @map("payment_options")
  paymentSelectionMode String  @default("single") @map("payment_selection_mode")

  draftQuestions Json? @map("draft_questions")

  teamId       String?
  collectionId String? @map("collection_id")

  createdAt   DateTime  @default(now()) @map(name: "created_at")
  updatedAt   DateTime  @updatedAt @map(name: "updated_at")
  publishedAt DateTime? @map(name: "published_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  collection  Collection?    @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  questions   Question[]
  responses   FormResponse[]
  views       FormView[]
  fileUploads FileUpload[]

  @@index([userId])
  @@index([slug])
  @@index([teamId])
  @@index([collectionId])
  @@map(name: "forms")
}

model Question {
  id          String       @id @default(cuid())
  formId      String
  order       Int
  type        QuestionType
  title       String       @default("")
  description String?
  required    Boolean      @default(false)
  properties  Json         @default("{}")
  logic       Json         @default("[]")

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  form    Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([formId])
  @@map(name: "questions")
}

model FormResponse {
  id          String    @id @default(cuid())
  formId      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  ipAddress   String?
  userAgent   String?
  referrer    String?

  paymentStatus           PaymentStatus? @map("payment_status")
  paymentAmount           Int?           @map("payment_amount")
  paymentCurrency         String?        @map("payment_currency")
  stripeCheckoutSessionId String?        @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?        @map("stripe_payment_intent_id")
  selectedPaymentOptionIds Json?         @map("selected_payment_option_ids")

  form    Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([formId])
  @@index([formId, completedAt])
  @@index([formId, paymentStatus])
  @@map(name: "form_responses")
}

model Answer {
  id         String @id @default(cuid())
  responseId String
  questionId String
  value      String @default("")
  fileUrl    String?

  createdAt DateTime @default(now()) @map(name: "created_at")

  response FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([responseId])
  @@index([questionId])
  @@map(name: "answers")
}

model FormView {
  id        String   @id @default(cuid())
  formId    String
  viewedAt  DateTime @default(now())
  ipAddress String?
  userAgent String?
  referrer  String?

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map(name: "form_views")
}

model Team {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  accessAllCollections Boolean  @default(false) @map("access_all_collections")
  createdAt            DateTime @default(now()) @map(name: "created_at")
  updatedAt            DateTime @updatedAt @map(name: "updated_at")

  members         TeamMember[]
  invites         TeamInvite[]
  forms           Form[]
  collectionTeams CollectionTeam[]

  @@map(name: "teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map(name: "joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map(name: "team_members")
}

model TeamInvite {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  role      TeamRole @default(MEMBER)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now()) @map(name: "created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
  @@map(name: "team_invites")
}

model Collection {
  id        String   @id @default(cuid())
  name      String
  userId    String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  forms Form[]
  teams CollectionTeam[]

  @@index([userId])
  @@map("collections")
}

model CollectionTeam {
  id           String   @id @default(cuid())
  collectionId String   @map("collection_id")
  teamId       String   @map("team_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([collectionId, teamId])
  @@index([collectionId])
  @@index([teamId])
  @@map("collection_teams")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  key        String?   @unique               // deprecated, nullable for migration
  hashedKey  String    @unique @map("hashed_key")
  keyPrefix  String    @map("key_prefix")     // first 7 chars for display
  lastUsedAt DateTime? @map(name: "last_used_at")
  createdAt  DateTime  @default(now()) @map(name: "created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map(name: "api_keys")
}

// ---------------------------------------------------------------------------
// File Uploads (S3-compatible Storage)
// ---------------------------------------------------------------------------

model FileUpload {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  formId    String    @map("form_id")
  key       String    @unique
  fileName  String    @map("file_name")
  fileSize  Int       @map("file_size")
  mimeType  String    @map("mime_type")
  url       String
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([formId])
  @@index([expiresAt])
  @@map("file_uploads")
}
