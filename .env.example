# =============================================================================
# GudForm Core — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# For Docker Compose, copy to .env in the project root.

# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Required
# =============================================================================

# Auth secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL connection string
DATABASE_URL='postgresql://gudform:gudform@localhost:5432/gudform'

# Encryption key for sensitive data — generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Email service (https://resend.com)
RESEND_API_KEY=

# S3-compatible storage (Cloudflare R2, MinIO, AWS S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gudform-uploads
R2_PUBLIC_URL=http://localhost:9000/gudform-uploads

# =============================================================================
# Optional — Payment Collection
# =============================================================================
# Set these to enable payment collection on forms via Stripe.

# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# =============================================================================
# Optional — Misc
# =============================================================================

# Bearer token for the /api/cron/cleanup-files endpoint
# CRON_SECRET=
