# App URL — no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional: NextAuth infers this in development
# NEXTAUTH_URL=http://localhost:3000
# Required behind Docker / a reverse proxy:
# AUTH_TRUST_HOST=true
# AUTH_URL=http://localhost:3080

# Optional Google OAuth. Set NEXT_PUBLIC_GOOGLE_AUTH=true to show the button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_GOOGLE_AUTH=true

# Database
DATABASE_URL=postgres://gudform:gudform@localhost:5432/gudform

# Optional email (Resend). If unset, registration auto-verifies accounts.
# Team invites still create a link; configure Resend to email that link.
# RESEND_API_KEY=

# Optional verified from-address for Resend emails.
# REQUIRED for auto-responder to work with arbitrary submitter emails.
# The default onboarding@resend.dev only delivers to your verified account email.
# Add your domain at https://resend.com/domains then set this to:
# RESEND_FROM=GudForm <noreply@yourdomain.com>

# Optional Cloudflare Turnstile on public form submit. Omit both to skip.
# TURNSTILE_SECRET=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Storage: local (default when R2 is unset) or r2
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Optional Cloudflare R2 (production file storage)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# CRON_SECRET=
